<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/overlay_composite_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|top"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Subtle Dancing Mic Mascot -->
        <com.example.monday.ui.overlay.DancingMicView
            android:id="@+id/dancing_mic_view"
            android:layout_width="28dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="true" />

        <!-- Slim, Sleek Expense Edge Tab -->
        <LinearLayout
            android:id="@+id/overlay_button_container"
            android:layout_width="18dp"
            android:layout_height="62dp"
            android:layout_gravity="end"
            android:background="@drawable/overlay_edge_tab_background"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Add Expense"
                android:src="@drawable/ic_add_expense"
                android:tint="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="₹"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
